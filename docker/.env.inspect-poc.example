# Copy to .env.inspect-poc and fill from Portainer → prod Immich stack → Environment

# Same library path as prod (read-only in compose)
PROD_UPLOAD_LOCATION=/path/from/prod/UPLOAD_LOCATION

# Match prod Immich version for ML image tags
IMMICH_VERSION=v3.4.2

# Clone DB credentials (can match prod; this DB is a separate volume)
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich

# Host folder containing immich.dump (created in step 1)
DUMP_PATH=./inspect-dump

# Required by Immich even for this PoC stack
UPLOAD_LOCATION=${PROD_UPLOAD_LOCATION}
DB_DATA_LOCATION=./inspect-postgres-unused
